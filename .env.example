# Copie este arquivo para .env e ajuste os valores.
# O .env real NÃO é versionado (ver .gitignore).
# Regra do projeto: apenas src/purchase_intent/config.py lê estas variáveis.

# ---------- MLflow ----------
# O Model Registry NÃO funciona com backend de arquivo: exige banco de dados.
# Duas opções atendem — sqlite local (`sqlite:///mlflow.db`) ou o servidor do
# compose. O projeto usa o SERVIDOR, porque o sqlite local grava dentro do
# container e os experimentos somem no `docker run --rm`; no servidor, banco e
# artefatos ficam num volume nomeado.
#
# Suba antes de treinar:  docker compose up -d mlflow
# Dentro do compose, o serviço `pipeline` usa http://mlflow:5000 (injetado lá).
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=purchase-intent
MLFLOW_REGISTERED_MODEL_NAME=purchase-intent-classifier

# ---------- Dados ----------
# Fonte do dataset (UCI - Online Shoppers Purchasing Intention)
DATASET_URL=https://archive.ics.uci.edu/static/public/468/online+shoppers+purchasing+intention+dataset.zip
RAW_DATA_PATH=data/raw/online_shoppers_intention.csv
PROCESSED_DATA_DIR=data/processed

# ---------- Artefatos ----------
MODELS_DIR=models
REPORTS_DIR=reports
PARAMS_PATH=configs/params.yaml

# ---------- Reprodutibilidade ----------
RANDOM_SEED=42

# ---------- Observabilidade ----------
LOG_LEVEL=INFO
