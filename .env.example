# Copie este arquivo para .env e ajuste os valores.
# O .env real NÃO é versionado (ver .gitignore).
# Regra do projeto: apenas src/purchase_intent/config.py lê estas variáveis.

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=purchase-intent
MLFLOW_REGISTERED_MODEL_NAME=purchase-intent-classifier

# ---------- Dados ----------
# Fonte do dataset (UCI - Online Shoppers Purchasing Intention)
DATASET_URL=https://archive.ics.uci.edu/static/public/468/online+shoppers+purchasing+intention+dataset.zip
RAW_DATA_PATH=data/raw/online_shoppers_intention.csv
PROCESSED_DATA_DIR=data/processed

# ---------- Artefatos ----------
MODELS_DIR=models
REPORTS_DIR=reports
PARAMS_PATH=configs/params.yaml

# ---------- Reprodutibilidade ----------
RANDOM_SEED=42

# ---------- Observabilidade ----------
LOG_LEVEL=INFO
