# Contexto de build enxuto: só entra o que é necessário para instalar e rodar.
.git/
.gitignore
# .dvc/config precisa entrar (identifica /app como projeto DVC).
# Cache, rascunho e config pessoal do remote ficam de fora.
.dvc/cache/
.dvc/tmp/
.dvc/config.local
.venv/
poetry.toml
venv/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Segredos nunca entram na imagem — as variáveis são injetadas em runtime.
.env
.env.local

# O CSV bruto é ENTRADA dos stages (deps no dvc.yaml) e entra na imagem.
# Tudo que é SAÍDA do pipeline fica de fora: seria embutir resultado velho.
data/processed/
models/
reports/
mlruns/
mlartifacts/
mlflow.db

docs/
*.md
!README.md

.vscode/
.idea/
.DS_Store
Thumbs.db
